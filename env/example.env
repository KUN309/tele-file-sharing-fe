### Telegram Bot ###
TELEGRAM_BOT_TOKEN=YOUR_TOKEN

### Backend API Base ###
# Ví dụ: https://yourdomain.com/api
BE_API_BASE=https://your_backend/api

### Webhook Config ###
USE_WEBHOOK=false
WEBHOOK_URL=https://yourdomain.com/webhook
PORT=YOUR_PORT

### Optional but recommended ###
# Timeout cho request tới backend
API_TIMEOUT=10

# Kích hoạt debug mode
DEBUG=false

# Local path để lưu file tạm thời
TEMP_DIR=/tmp/bot

# Nếu bot phải truy cập file server riêng
FILE_BASE_URL=https://your_backend/static
